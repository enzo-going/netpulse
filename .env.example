# Copie para .env e ajuste. O arquivo .env nunca vai para o repositorio.

# demo  = coletor sintetico, nao toca na rede (use para testar o projeto)
# live  = coletor real (ping, TCP, SNMP, SSL)
NETPULSE_MODE=demo

# Caminho do banco SQLite
NETPULSE_DATABASE_URL=sqlite:///./data/netpulse.db

# Quantos checks rodam em paralelo
NETPULSE_MAX_CONCURRENCY=32

# Intervalo padrao entre execucoes de um check, em segundos
NETPULSE_DEFAULT_INTERVAL=60

# Falhas consecutivas antes de abrir um incidente
NETPULSE_FAILURE_THRESHOLD=3

# Janela, em segundos, para agrupar falhas da mesma sub-rede num incidente unico
NETPULSE_CORRELATION_WINDOW=180

# Diretorio opcional do build do dashboard. O Docker ja configura este valor.
# NETPULSE_FRONTEND_DIR=../frontend/dist

# Analise de incidentes por IA. Sem chave, o sistema roda normalmente e apenas
# nao gera o parecer.
ANTHROPIC_API_KEY=
NETPULSE_AI_MODEL=claude-sonnet-5
